{
    "name": "serendipity_hq/bundle-aws-ses-monitor",
    "type": "symfony-bundle",
    "description": "Symfony bundle to monitor AWS SES bounces, complaints and deliveries through SNS. Comes with a command to fully configure the topics and includes a configurable Symfony Mailer filter to avoid sending emails to bounced and complained emails.",
    "keywords": ["aws", "ses", "sns", "bounce", "complaints", "blacklist", "mailer"],
    "homepage": "https://github.com/Aerendir/bundle-aws-ses-monitor",
    "license": "MIT",
    "support": {
        "docs": "https://github.com/Aerendir/bundle-aws-ses-monitor/tree/dev/docs",
        "issues": "https://github.com/Aerendir/bundle-aws-ses-monitor/issues"
    },
    "authors": [
        {
            "name": "Adamo Aerendir Crespi",
            "email": "aerendir@serendipityhq.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "aws/aws-php-sns-message-validator": "^1.5",
        "aws/aws-sdk-php": "^3.39.0",
        "aws/aws-sdk-php-symfony": "^2.7",
        "doctrine/collections": "^1.6 || ^2.0",
        "doctrine/dbal": "^3.6 || ^4.0",
        "doctrine/doctrine-bundle": "^2.11 || ^3.0",
        "doctrine/orm": "^2.17 || ^3.0",
        "symfony/config": "^6.4 || ^7.4 || ^8.0",
        "symfony/console": "^6.4 || ^7.4 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.4 || ^8.0",
        "symfony/event-dispatcher": "^6.4 || ^7.4 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/http-foundation": "^6.4 || ^7.4 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.4 || ^8.0",
        "symfony/mailer": "^6.4 || ^7.4 || ^8.0",
        "symfony/mime": "^6.4 || ^7.4 || ^8.0",
        "symfony/routing": "^6.4 || ^7.4 || ^8.0",
        "symfony/yaml": "^6.4 || ^7.4 || ^8.0"
    },
    "require-dev": {
        "ext-ast": "*",
        "bamarni/composer-bin-plugin": "^1.4",
        "phpstan/phpstan": "2.3.1",
        "phpstan/phpstan-doctrine": "2.0.28",
        "phpstan/phpstan-phpunit": "2.0.21",
        "phpstan/phpstan-symfony": "2.1.0",
        "rector/rector": "2.6.7",
        "roave/security-advisories": "dev-master",
        "serendipity_hq/rector-config": "1.1.20",
        "symfony/var-dumper": "^6.4 || ^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "SerendipityHQ\\Bundle\\AwsSesMonitorBundle\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SerendipityHQ\\Bundle\\AwsSesMonitorBundle\\Tests\\": "tests"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "bamarni/composer-bin-plugin": true,
            "symfony/flex": true
        }
    },
    "scripts": {
        "bin": "echo 'bin not installed'",
        "post-install-cmd": ["@composer bin all install --ansi"],
        "post-update-cmd": ["@composer bin all update --ansi"]
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": false
        }
    }
}
